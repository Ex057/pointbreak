# Default live source: Deriv's free, unauthenticated public WebSocket. This is
# required for Volatility and other synthetic indices. Use `fixture` only for
# offline development, or `yahoo` as a real-market fallback.
DATA_SOURCE=deriv
DERIV_APP_ID=1089
# Optional custom endpoint. The built-in default is Deriv's no-auth public URL:
# wss://api.derivws.com/trading/v1/options/ws/public
# DERIV_URL=wss://api.derivws.com/trading/v1/options/ws/public
# History bars requested from Deriv (600 is a stable default).
# CANDLE_HISTORY_BARS=600
# In-memory bars retained per symbol/timeframe.
# CANDLE_CACHE_MAXLEN=2000

# Optional compatibility setting for a custom legacy DERIV_URL. It is not sent
# to the default public Options endpoint.
# DERIV_API_TOKEN=your_token_here

# Live macro/news context
# Marketaux free plan is the current preferred live financial headline source.
# Sign up at https://www.marketaux.com/ and paste the API token below.
HEADLINE_PROVIDER=marketaux
# MARKETAUX_API_KEY=your_marketaux_key_here

# Optional economic calendar provider. If unset, Macro Pulse falls back to
# headline-only mode and simply shows calendar as disabled.
# TRADING_ECONOMICS_API_KEY=your_trading_economics_key_here

# Explanation-only AI provider for the verdict panel. This never changes the
# planner's decision; it only explains the current setup in cleaner language.
AI_PROVIDER=builtin

# Optional free local provider.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3

# Optional free-tier hosted provider.
# GEMINI_API_KEY=your_google_ai_studio_key_here
# GEMINI_MODEL=gemini-3.5-flash

# Local Claude agent. Powers both the verdict commentary (set AI_PROVIDER=claude)
# and the end-of-day "what-if" strategy analyst, which reads the counterfactual
# backtest of the day's rejected setups and proposes bounded, shadow-tested
# parameter tweaks. The deterministic planner stays authoritative and NOTHING is
# auto-applied — you approve each recommendation in the UI.
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# ANTHROPIC_MODEL=claude-opus-4-8

# End-of-day what-if review. The always-on monitor fires it once per day at/after
# EOD_REVIEW_HOUR (local, using EOD_TZ_OFFSET_HOURS) for EOD_REVIEW_PAIR.
# EOD_REVIEW_PAIR=xauusd
# EOD_REVIEW_HOUR=21
# EOD_TZ_OFFSET_HOURS=3
# ARM_SCORE_MIN=0.45
